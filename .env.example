# Copy to .env.local (not committed) to turn on accounts and sync when running Haven locally.
# Both values are in your Supabase project under Project Settings → API.
# The anon/publishable key is meant to be public; never put the service_role/secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
