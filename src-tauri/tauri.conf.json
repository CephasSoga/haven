{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haven",
  "version": "0.1.0",
  "identifier": "com.cephassoga.haven",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Haven",
        "width": 1320,
        "height": 880,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "A calm home for your days, your money and your thoughts",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNTAyRjk5ODk2QjIwOEUKUldTT0lHdUptUzlRMHNXSXRjZHJuRVlxd2xHTHNTbzVoRHNEcXJCRlhRRzZpdzk0ZWpvWmdEZkoK",
      "endpoints": [
        "https://github.com/CephasSoga/haven/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
